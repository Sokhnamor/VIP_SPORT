# Configuration Docker Compose (copier en .env à la racine puis adapter)
APP_NAME=GymManager
APP_ENV=production
APP_DEBUG=false
# Générer avec : docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://gym.example.sn
FRONTEND_URL=https://gym.example.sn
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
GYM_TIMEZONE=Africa/Dakar
LOG_CHANNEL=daily
LOG_LEVEL=info

WEB_PORT=8080
MAILPIT_PORT=8025

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gymmanager
DB_USERNAME=gymmanager
DB_PASSWORD=change-moi-mot-de-passe-long
DB_ROOT_PASSWORD=change-moi-aussi-root

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
# true dès que le site est servi en HTTPS (obligatoire en production)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=gym.example.sn,localhost:8080
TRUSTED_PROXIES=*

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@gym.example.sn
MAIL_FROM_NAME=GymManager

SCAN_RATE_PER_MINUTE=60
SCAN_UNKNOWN_PER_MINUTE=10
BACKUP_PATH=/backups

ADMIN_IDENTIFIANT=admin
ADMIN_PASSWORD=
GYM_NOM="GymManager Almadies"
SEED_DEMO=false
