# --- Application -------------------------------------------------------------
APP_NAME=GymManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL publique (HTTPS obligatoire en production : la caméra du poste de scan l'exige)
APP_URL=http://localhost:5173
# Domaine du front (CORS limité à ce domaine)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# Les dates sont stockées en UTC ; le fuseau de la salle sert à l'affichage et aux règles « du jour ».
GYM_TIMEZONE=Africa/Dakar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base de données (MySQL 8) -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymmanager
DB_USERNAME=gymmanager
DB_PASSWORD=

# --- Sessions (cookies Sanctum) ----------------------------------------------
SESSION_DRIVER=database
# Durée maximale ; l'inactivité est limitée à 30 min (admin, réception) par un middleware.
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Domaines autorisés à utiliser l'authentification par cookies (hôte[:port] du front)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost
# Proxys de confiance (adresse du reverse proxy nginx ; * derrière Docker)
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- E-mails (Mailpit en développement) --------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gymmanager.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Poste de scan -----------------------------------------------------------
SCAN_RATE_PER_MINUTE=60
SCAN_UNKNOWN_PER_MINUTE=10

# --- Sauvegardes -------------------------------------------------------------
# Dossier des sauvegardes quotidiennes (par défaut storage/app/backups)
BACKUP_PATH=

# --- Données initiales (php artisan db:seed) ---------------------------------
ADMIN_IDENTIFIANT=admin
# Laisser vide : un mot de passe provisoire aléatoire est affiché au seeding.
# Dans tous les cas, il doit être changé à la première connexion.
ADMIN_PASSWORD=
GYM_NOM="GymManager Almadies"
# Jeu de démonstration (45 jours d'activité fictive). Jamais en production.
SEED_DEMO=false
